# fixture (default) serves fixtures/*.json. live proxies to the Modal backend.
DATA_MODE=fixture
# Your teammate's Modal web endpoint, e.g. https://org--forkbench-api.modal.run
API_URL=http://localhost:8787
# Shared bearer token for the Modal backend. Must match the FORKBENCH_API_TOKEN secret
# on the Modal side. Attached by the proxy server side, so it never reaches the browser.
# Only needed when DATA_MODE=live.
API_TOKEN=
