# Only the frontier adapter needs credentials. Scripted policies run offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
FRONTIER_PROVIDER=openai
POLICY_TIMEOUT_SECONDS=40
# Optional enhancements; not used by the local core.
JEV_API_KEY=
HYPER3D_API_KEY=
# Modal uses `modal setup` rather than requiring a key here.
FAULTLINE_DATA_DIR=data
FAULTLINE_PUBLIC_URL=http://localhost:3300
