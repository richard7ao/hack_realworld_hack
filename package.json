{
  "name": "forkbench",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/lib/score.test.ts src/lib/sim/arm.test.ts src/lib/sim/generate.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm fixtures:validate",
    "fixtures:validate": "node --import tsx fixtures/validate.ts",
    "fixtures:build": "node --import tsx fixtures/build.ts",
    "dev:full": "bash scripts/dev.sh",
    "backend:test": ".venv/bin/python -m pytest backend/tests -q",
    "smoke": ".venv/bin/python scripts/smoke_test.py",
    "benchmark": ".venv/bin/python scripts/run_benchmark.py",
    "contracts": ".venv/bin/python -m scripts.export_contracts"
  },
  "dependencies": {
    "@react-three/fiber": "^9",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
